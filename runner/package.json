{
  "name": "cs-agent-sandbox-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/guest.ts src/npm-ensure.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs",
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "test:wsb": "npm run build && node scripts/smoke-wsb.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
