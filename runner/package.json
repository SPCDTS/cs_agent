{
  "name": "cs-agent-windows-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/guest.ts src/wsb-start-helper.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs && npm run build:cua && npm run build:android",
    "build:cua": "esbuild scripts/cua-reverse-bridge.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/reverse-mcp-bridge.cjs",
    "build:android": "esbuild scripts/android-connector.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/android-connector.cjs",
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "test:wsb": "npm run build && node scripts/smoke-wsb.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "typebox": "1.3.27",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
