// 测试专用配置：与 wrangler.jsonc 相同，去掉 routes 与 containers（测试池不支持容器），模型默认用 faux。改 wrangler.jsonc 时同步改这里。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 限制每次调用的活跃 CPU；网络等待不计入 CPU，避免异常计算消耗套餐额度
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
  // */5：外部事件轮询兜底（Gmail 推送优先）；UTC 19:30 = 北京 03:30：聊天摘要与清理、记忆整理、审计保留（src/maintenance）。
  // index.ts 的 scheduled 按 cron 字符串分派
  "triggers": { "crons": ["*/5 * * * *", "30 19 * * *"] },
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "joule-bucket" }],
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "ThreadDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "REQUESTS", "class_name": "RequestsDO" },
      { "name": "BRIDGE", "class_name": "BridgeDO" },
      { "name": "SCHEDULE", "class_name": "ScheduleDO" },
      { "name": "EVENTS", "class_name": "EventsDO" },
      // 子 agent：每个一个对象，名字 sub:<父线程键>:<id>，结束 14 天后自删
      { "name": "SUBAGENT", "class_name": "SubagentDO" },
      { "name": "SANDBOX", "class_name": "SandboxDO" },
      { "name": "SANDBOX_FLEET", "class_name": "SandboxFleetDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BridgeDO"] },
    { "tag": "v3", "new_sqlite_classes": ["MagpieContainer"] },
    { "tag": "v4", "new_sqlite_classes": ["RegistryDO"] },
    { "tag": "v5", "new_sqlite_classes": ["ScheduleDO"] },
    { "tag": "v6", "new_sqlite_classes": ["EventsDO"] },
    { "tag": "v7", "deleted_classes": ["MagpieContainer"] },
    { "tag": "v8", "new_sqlite_classes": ["SubagentDO"] },
    { "tag": "v9", "new_sqlite_classes": ["SandboxDO"] },
    { "tag": "v10", "new_sqlite_classes": ["RequestsDO"] },
    { "tag": "v11", "new_sqlite_classes": ["SandboxFleetDO"] }
  ],
  // QQ_OWNER、NAPCAT_TOKEN、DEEPSEEK_API_KEY、OAUTH_STORE_KEY 等都是 secrets（wrangler secret put），不写在这里
  "vars": {
    "CS_AGENT_COMMIT": "dev",
    "REMOTE_SANDBOX_ENABLED": "false",
    "PUBLIC_ORIGIN": "https://agent.spcdts.dev",
    "QQ_GROUP_MENTIONS": true,
    "MEMORY_EXTRACT_MODEL": "",
    "MEMORY_EXTRACT_NAMESPACES": "owner",
    "MODEL_PROVIDER": "faux",
    "MODEL_ID": "test",
    "GMAIL_PUBSUB_SERVICE_ACCOUNT": "",
    "GMAIL_PUBSUB_TOPIC": ""
  }
}
