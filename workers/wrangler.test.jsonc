// 测试专用配置：与 wrangler.jsonc 相同，去掉 containers（vitest-pool-workers 自带的 wrangler 不认 durable_object
// 调度策略）、routes 与 dev；MAGPIE 绑定保留，faux 模式不会碰容器。改 wrangler.jsonc 时同步改这里。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // CPU 限额只计活跃计算；回合里的 JSON 处理偶有峰值，放到上限 5 分钟
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // UTC 19:30 = 北京 03:30：聊天摘要与清理、记忆整理、审计保留（src/maintenance）
  "triggers": { "crons": ["30 19 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "ThreadDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "BRIDGE", "class_name": "BridgeDO" },
      { "name": "MAGPIE", "class_name": "MagpieContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BridgeDO"] },
    { "tag": "v3", "new_sqlite_classes": ["MagpieContainer"] },
    { "tag": "v4", "new_sqlite_classes": ["RegistryDO"] }
  ],
  // QQ_OWNER、NAPCAT_TOKEN、R2_*、MAGPIE_SYNC_PASSPHRASE 都是 secrets（wrangler secret put），不写在这里
  "vars": {
    "CS_AGENT_COMMIT": "dev",
    "PUBLIC_ORIGIN": "https://agent.spcdts.dev",
    "QQ_GROUP_MENTIONS": true,
    "MEMORY_EXTRACT_MODEL": "",
    "MEMORY_EXTRACT_NAMESPACES": "owner",
    "MODEL_PROVIDER": "faux",
    "MODEL_ID": "test",
    "MAGPIE_URL": ""
  }
}
