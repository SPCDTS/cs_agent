{
  "name": "cs-agent-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cs-agent on Cloudflare Workers: one Durable Object per conversation (docs/WORKERS-DESIGN.md)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
