  "dependencies": {
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-codemode": "^1.4.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jose": "^6.2.14",
    "rrule": "^2.8.1",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=24"
