// P0 将 NapCat 连接与会话分开，空闲连接可独立休眠。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // CPU 限额只计活跃计算；回合里的 JSON 处理偶有峰值，放到上限 5 分钟
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // 自定义域名在 Cloudflare 托管的 zone 下；*.workers.dev 在国内不稳定，NapCat 反向 WS 只连这个
  "routes": [{ "pattern": "agent.spcdts.dev", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "ThreadDO" },
      { "name": "BRIDGE", "class_name": "BridgeDO" },
      { "name": "MAGPIE", "class_name": "MagpieContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BridgeDO"] },
    { "tag": "v3", "new_sqlite_classes": ["MagpieContainer"] }
  ],
  // magpie 模型网关跑在 Containers 上（magpie/Dockerfile）。本账户只允许 durable_object 调度策略：
  // 镜像以命名方式交给 DO（ctx.container.images.magpie），实例规格在 start() 里给；本地 dev 与测试不起容器
  "containers": [
    { "class_name": "MagpieContainer", "scheduling_policy": "durable_object", "images": { "magpie": { "dockerfile": "./magpie/Dockerfile" } } }
  ],
  "dev": { "enable_containers": false },
  // QQ_OWNER、NAPCAT_TOKEN、R2_*、MAGPIE_SYNC_PASSPHRASE 都是 secrets（wrangler secret put），不写在这里
  // 生产：模型经 magpie 容器（MAGPIE_URL=container）。测试用 wrangler.test.jsonc 覆盖为 faux
  "vars": {
    "CS_AGENT_COMMIT": "dev",
    "QQ_GROUP_MENTIONS": true,
    "MEMORY_EXTRACT_MODEL": "",
    "MEMORY_EXTRACT_NAMESPACES": "owner",
    "MODEL_PROVIDER": "magpie",
    "MODEL_ID": "deepseek/deepseek-flash",
    "MAGPIE_URL": "container"
  }
}
