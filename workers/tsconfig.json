{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2024"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "browser/contracts.ts", "browser/*-contracts.ts", "vitest.config.ts", "worker-configuration.d.ts"],
  "exclude": ["test/chat-navigation-layout.test.ts", "test/topology-layout.test.ts"]
}
