{
  "version": 1,
  "enabled": true,
  "servers": [
    {
      "id": "notion",
      "enabled": true,
      "transport": {
        "kind": "streamable-http",
        "url": "https://mcp.notion.com/mcp"
      },
      "credential": {
        "kind": "oauth",
        "accountId": "owner-notion",
        "revision": "1",
        "registration": "cimd",
        "clientMetadataUrl": "https://agent.spcdts.dev/oauth/client-metadata.json",
        "scope": "default"
      },
      "access": {
        "kind": "owner-private"
      },
      "tools": {
        "allow": [
          "notion-search",
          "notion-fetch",
          "notion-get-self",
          "notion-get-users",
          "notion-get-comments",
          "notion-query-data-sources",
          "notion-list-recent-pages",
          "notion-create-pages",
          "notion-update-page",
          "notion-create-comment"
        ],
        "eventAllow": [
          "notion-search",
          "notion-fetch"
        ],
        "readOnly": [
          "notion-search",
          "notion-fetch",
          "notion-get-self",
          "notion-get-users",
          "notion-get-comments",
          "notion-query-data-sources",
          "notion-list-recent-pages"
        ]
      },
      "replay": "unsafe",
      "resourceAllow": [
        "notion://docs/"
      ]
    },
    {
      "id": "cs2-workshop",
      "enabled": true,
      "transport": {
        "kind": "streamable-http",
        "url": "https://workshop.spcdts.dev/mcp",
        "secretHeaders": {
          "Authorization": "CS2_WORKSHOP_AUTHORIZATION"
        }
      },
      "credential": {
        "kind": "external-account",
        "accountId": "owner-workshop",
        "revision": "1"
      },
      "access": {
        "kind": "owner-private"
      },
      "tools": {
        "allow": [
          "workshop_browse",
          "workshop_context",
          "workshop_prepare",
          "workshop_edit",
          "workshop_mode",
          "workshop_trial",
          "workshop_produce",
          "workshop_status",
          "workshop_results"
        ],
        "readOnly": [
          "workshop_browse",
          "workshop_context",
          "workshop_status"
        ],
        "eventAllow": []
      },
      "replay": "unsafe",
      "resourceAllow": [
        "workshop://guide",
        "workshop://edit-director",
        "workshop://editing-schema"
      ]
    }
  ]
}
