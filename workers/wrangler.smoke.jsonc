{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 仅供 wrangler dev --local 使用；不提供线上公开入口。
  "name": "cs-agent-remote-local-smoke",
  "workers_dev": false,
  "preview_urls": false,
  "main": "test/fixtures/remote-smoke-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "local-smoke-assets" }],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "SandboxDO" },
      { "name": "SANDBOX_FLEET", "class_name": "SandboxFleetDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxDO", "SandboxFleetDO"] }],
  "vars": { "REMOTE_SANDBOX_ENABLED": "true", "ADMIN_TOKEN": "synthetic-local-smoke-only" },
  "dev": { "ip": "127.0.0.1", "port": 8797 }
}
