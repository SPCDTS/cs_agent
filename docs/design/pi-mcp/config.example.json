{
  "version": 1,
  "enabled": true,
  "limits": {
    "connectMs": 10000,
    "callMs": 60000,
    "connections": 16,
    "queuedPerConnection": 16,
    "idleMs": 300000,
    "catalogTtlMs": 300000,
    "maxPages": 20,
    "maxTools": 200,
    "maxResources": 200,
    "catalogBytes": 2097152,
    "schemaBytes": 65536,
    "schemaDepth": 64,
    "visibleTools": 64,
    "visibleSchemaBytes": 524288,
    "argumentBytes": 262144,
    "messageBytes": 12582912,
    "textBytes": 32768,
    "structuredBytes": 262144,
    "imageBytes": 5242880,
    "contentBytes": 8388608,
    "images": 2,
    "retainedRevisions": 128,
    "retainedCatalogBytes": 33554432,
    "closePerConnectionMs": 3000,
    "closeTotalMs": 10000
  },
  "servers": [
    {
      "id": "docs",
      "enabled": true,
      "transport": {
        "kind": "streamable-http",
        "url": "https://mcp.example.com/mcp",
        "headers": {},
        "secretHeaders": { "Authorization": "DOCS_AUTH_HEADER" },
        "allowLoopbackHttp": false
      },
      "credential": { "kind": "external-account", "accountId": "owner-docs", "revision": "1" },
      "tools": { "allow": ["search", "fetch_document"] },
      "resources": { "allow": [] },
      "access": { "kind": "owner-private", "allowScheduled": false, "allowWake": false },
      "replay": "unsafe"
    },
    {
      "id": "notion",
      "enabled": true,
      "transport": {
        "kind": "streamable-http",
        "url": "https://mcp.notion.com/mcp"
      },
      "credential": {
        "kind": "oauth",
        "accountId": "owner-notion",
        "revision": "1",
        "clientMetadataUrl": "https://jule-agent.vercel.app/oauth/client-metadata.json",
        "registration": "cimd",
        "scope": "default"
      },
      "tools": {
        "allow": [
          "notion-search"
        ]
      },
      "resources": { "allow": ["notion://docs/"] },
      "access": {
        "kind": "owner-private"
      },
      "replay": "unsafe"
    }
  ]
}
