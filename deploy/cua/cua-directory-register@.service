[Unit]
Description=Register a Cua device directory on loopback port %i
Requires=cua-directory.service
After=cua-directory.service caddy.service

[Service]
Type=oneshot
User=cua-directory
Group=cua-directory
ReadWritePaths=/var/lib/cs-agent-cua
EnvironmentFile=/etc/cs-agent/cua/spaces/%i.env
Environment=CUA_HOME=/var/lib/cs-agent-cua CUA_CREDENTIAL_STORE=file CUA_MESH=off CUA_TELEMETRY=0 DO_NOT_TRACK=1 CUA_TELEMETRY_FORBID_NETWORK=1 CUA_RELAY_URL=http://127.0.0.1:1
ExecStart=/usr/local/bin/cua --daemon /run/cs-agent-cua/cua.sock spaces add http://127.0.0.1:%i/m/${MACHINE_ID}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost
