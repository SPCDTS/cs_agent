# 将示例域名和 machine-id 换成实际值。两个设备不能共用端口或注册令牌。
{
	auto_https disable_redirects
	servers :443 {
		protocols h1 h2
	}
	servers 127.0.0.1:18281 {
		protocols h1 h2 h2c
	}
	servers 127.0.0.1:18282 {
		protocols h1 h2 h2c
	}
}

(join) {
	@{args[0]} {
		method GET
		path /relay/v1/connect
		header Upgrade websocket
		header X-Cua-Machine-Id {args[0]}
	}
	handle @{args[0]} {
		reverse_proxy 127.0.0.1:{args[1]} {
			header_up X-Cua-Machine-Id {args[0]}
		}
	}
}

relay.example.org {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	import join computer-alpha 18181
	import join computer-bravo 18182
	handle {
		respond 404
	}
}

# Cua 的 direct ID 由 host:port 决定。每台设备独占一个回环端口，默认只接受目录请求。
(directory) {
	bind 127.0.0.1
	@catalog {
		method POST
		header Content-Type application/grpc*
		path /m/{args[0]}/cua.env.v1.SystemService/GetCapabilities /m/{args[0]}/cua.env.v1.DriverService/ListTools
	}
	handle @catalog {
		reverse_proxy h2c://127.0.0.1:{args[1]}
	}
	handle {
		respond 404
	}
}

# 可选。在允许读取主机名或 Mac 窗口的设备回环站点内导入，spacesd 校验该机 Bearer。
(device-inspection) {
	@inspection {
		remote_ip 127.0.0.1
		method POST
		header Content-Type application/grpc*
		path /m/{args[0]}/cua.env.v1.ProcessService/StartProcess /m/{args[0]}/cua.env.v1.DriverService/CallTool
	}
	handle @inspection {
		reverse_proxy h2c://127.0.0.1:{args[1]}
	}
}

http://127.0.0.1:18281 {
	# import device-inspection computer-alpha 18181
	import directory computer-alpha 18181
}

http://127.0.0.1:18282 {
	import directory computer-bravo 18182
}
