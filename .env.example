# NapCat OneBot v11（宿主机 loopback 端口经 host.docker.internal 可达）
NAPCAT_HTTP_URL=http://host.docker.internal:3000
NAPCAT_WS_URL=ws://host.docker.internal:3001
NAPCAT_TOKEN=
# 逗号分隔或 *
QQ_ALLOW_USERS=10000001
# 逗号分隔
QQ_ALLOW_GROUPS=200000001
QQ_GROUP_MENTIONS=true
# owner：私聊时 codex 可检索全部会话的聊天记录；留空 = QQ_ALLOW_USERS 的第一项
QQ_OWNER=

# 统一上下文消息库（/data/qq-messages.sqlite）与衰老任务
# 原始消息保留天数 / 日周摘要保留天数
HISTORY_RAW_DAYS=30
HISTORY_SUMMARY_DAYS=180
# 未被日/周摘要覆盖的原始消息（摘要失败或当天不足 5 条）最长保留天数（兜底上限）
HISTORY_RAW_HARD_MAX_DAYS=90
# 每日衰老任务的本地小时（容器默认 UTC；设 TZ=Asia/Shanghai 则按北京时间）
HISTORY_SUMMARY_HOUR=3
# 历史检索返回文本总字数上限（意图层与 codex 的 qq_context 共用）
QQ_CONTEXT_MAX_CHARS=2500

# ComfyUI
COMFYUI_URL=http://host.docker.internal:8188
# mcp | http（直连 ComfyUI HTTP API 的兜底）
COMFY_MODE=mcp
# 留空=模板/首个可用 checkpoint
COMFY_CHECKPOINT=
# API 格式工作流（本机为 Qwen Image 2.1 Turbo；宿主机无 SD1.5 checkpoint，默认模板不可用）
# 默认 /data/workflows/…：启动时若 /data/workflows 不存在则从镜像 /app/workflows 复制（不覆盖），codex 可修改；
# 仍可指回镜像内只读的 /app/workflows/qwen-image-2.1-turbo-api.json
COMFY_WORKFLOW_FILE=/data/workflows/qwen-image-2.1-turbo-api.json
# 提示词节点 id；留空自动识别第一个 *TextEncode* 节点
COMFY_PROMPT_NODE=4
COMFY_TIMEOUT_SEC=300

# 容器内 codex（固定会话）
CODEX_MODEL=gpt-6.1-sol
# 默认推理强度（写入 config.toml）；实际每轮由意图模型按请求选择 low/medium/high/xhigh/max 覆盖
CODEX_REASONING_EFFORT=high
# 容器内 landlock 不可用时改为 danger-full-access（容器本身即沙箱）
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_SEC=600
# codex 命令沙箱（workspace-write）：命令是否可联网；可写目录（逗号分隔绝对路径，/data 本身、/data/codex、/data/images、*.sqlite 会被拒绝）
CODEX_SANDBOX_NETWORK=true
CODEX_WRITABLE_ROOTS=/workspace,/data/prompts,/data/workflows
# codex 联网搜索：live | cached | disabled；结果注入量 low | medium | high
CODEX_WEB_SEARCH=live
CODEX_WEB_SEARCH_CONTEXT=low
# 单一 codex 线程安全阀：rollout 文件超过 N MB 或线程超过 N 天则新建线程
CODEX_ROLLOUT_MAX_MB=50
CODEX_THREAD_MAX_DAYS=90
# codex 浏览器 MCP：playwright（容器内 headless Chromium）| none
CODEX_BROWSER=playwright

# 意图识别模型：DeepSeek（OpenAI 兼容接口 https://api.deepseek.com，内置 pi-ai deepseek provider）
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL_ID=deepseek-flash
# DeepSeek API key（也可写作 DEEPSEEK_APIKEY，启动时自动映射为 DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY=
# deepseek-flash 支持 off/low/high/max；其他档位自动就近调整（如 medium → high）
AGENT_THINKING_LEVEL=low
AGENT_CONCURRENCY=2
# 其他可选 provider：
# AGENT_MODEL_PROVIDER=openai-codex   # 复用 /data/codex/auth.json 的 ChatGPT OAuth，无需 API key
# AGENT_MODEL_ID=gpt-6-luna
# AGENT_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# AGENT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

DATA_DIR=/data
WORKSPACE_DIR=/workspace
LOG_LEVEL=info
