# 供 workers/scripts/put-secrets.sh 读取，不由 Worker 自动加载；真实 .env 不提交。
# 与独立 NapCat 反向 WebSocket 客户端配置相同的令牌。
NAPCAT_TOKEN=
# owner QQ 号，多个账号用逗号分隔；首项用于 owner 投递。
QQ_OWNER=
# 可选白名单，多个 QQ / 群号用逗号分隔。
QQ_ALLOW_USERS=
QQ_ALLOW_GROUPS=
# 可选 DeepSeek 凭据；上传时映射为 DEEPSEEK_API_KEY。
DEEPSEEK_APIKEY=

# ADMIN_TOKEN 与 OAUTH_STORE_KEY 保存在 secrets/ 下，上传脚本仅在缺失时生成。
# ChatGPT 订阅在 /admin/ 中授权。模型、保留期等配置见 workers/wrangler.jsonc 与管理面板。
