# NapCat OneBot v11（默认 compose 内网，也可指向宿主机 NapCat）
NAPCAT_HTTP_URL=http://napcat:3000
NAPCAT_WS_URL=ws://napcat:3001
NAPCAT_TOKEN=
# WebUI 登录口令，随机生成
NAPCAT_WEBUI_TOKEN=
# WebUI 发布到宿主机的端口（默认 6099；宿主机仍跑着旧 NapCat 时改用其他端口，如 6098）
NAPCAT_WEBUI_PORT=6099
# 可选，供 NapCat 快速登录
QQ_BOT_ACCOUNT=
# 逗号分隔或 *
QQ_ALLOW_USERS=10000001
# 逗号分隔
QQ_ALLOW_GROUPS=200000001
QQ_GROUP_MENTIONS=true
# owner QQ 号列表（逗号分隔，如 10000001,10000002），共享私聊线程与全部权限，始终允许入站
# 首项为主账号，用于告警、面板身份和 owner 定时任务投递；留空 = QQ_ALLOW_USERS 第一项（* 则无 owner）
QQ_OWNER=

# 统一上下文消息库（/data/qq-messages.sqlite）与衰老任务
# 原始消息保留天数的全局缺省（0 = 永不清理，默认；面板设置页可按会话覆盖）/ 日周摘要保留天数
HISTORY_RAW_DAYS=0
HISTORY_SUMMARY_DAYS=180
# 未被日/周摘要覆盖的原始消息（摘要失败或当天不足 5 条）最长保留天数（兜底上限；保留天数为 0 的会话不适用）
HISTORY_RAW_HARD_MAX_DAYS=90
# 每日衰老任务的本地小时（容器默认 UTC；设 TZ=Asia/Shanghai 则按北京时间）
HISTORY_SUMMARY_HOUR=3
# 历史检索返回文本总字数上限（意图层与 codex 的 qq_context 共用）
QQ_CONTEXT_MAX_CHARS=2500

# 入站参考图：跨会话下载并发、每条输入的总截止时间（含排队）
# 按需图片召回：仅主进程 loopback 监听；每回合调用预算（旧名 MEDIA_RECALL_MAX_PER_TICKET 仍可用）
MEDIA_RECALL_PORT=8790
MEDIA_RECALL_MAX_PER_TURN=5
INCOMING_DOWNLOAD_CONCURRENCY=2
INCOMING_DOWNLOAD_DEADLINE_SEC=60

# 回复附件：单个文件 MiB、每轮文件数、禁止扩展名（逗号分隔）
ATTACH_FILE_MAX_MB=20
ATTACH_FILES_MAX=3
ATTACH_FILE_DENY_EXT=.exe,.bat,.cmd,.ps1,.vbs,.js,.scr,.msi,.com,.lnk

# 容器内 codex（固定会话）
# magpie（默认）经宿主机网关；openai 回退直连并使用容器 auth.json
CODEX_PROVIDER=magpie
CODEX_MAGPIE_URL=http://host.docker.internal:3425/v1
# magpie 模式启动 runner 时必填；仅通过环境变量注入，不写入 config.toml
CODEX_MAGPIE_KEY=
# 必须与 /codex/models 的 slug 完全一致；省略前缀会让 Codex 回退到默认模型元数据
CODEX_MODEL=codex/gpt-6.1-sol
# 上下文窗口优先取启动时的模型目录；查询失败才使用此回退值
CODEX_CONTEXT_WINDOW=400000
# 推理强度 low/medium/high/xhigh/max（写入 config.toml，codex 后端每轮也显式传入；不再按请求选择）
CODEX_REASONING_EFFORT=high
# 两个后端的回复均原文照发，只做 UTF-16 ≤4000 发送保护，后处理不调用模型
# 容器内 landlock 不可用时改为 danger-full-access（容器本身即沙箱）
CODEX_SANDBOX=workspace-write
# 官方 trace：保留天数（0 禁用请求负载记录）、普通文件总量上限 MiB（0 不限）
CODEX_TRACE_RETENTION_DAYS=14
CODEX_TRACE_MAX_MB=512
# 内置生图输出：先按天清理，再按 mtime 从旧到新限制总量；两个限制各以 0 禁用
# 1024 MiB = 1 GiB；仅清理 CODEX_HOME/generated_images，不影响 send_message 已登记的 Outbox 图片副本
CODEX_GENERATED_IMAGES_RETENTION_DAYS=7
CODEX_GENERATED_IMAGES_MAX_MB=1024
# codex 命令沙箱（workspace-write）：命令是否可联网；可写目录（逗号分隔绝对路径，/data 本身、/data/codex、/data/images、*.sqlite 会被拒绝）
CODEX_SANDBOX_NETWORK=true
CODEX_WRITABLE_ROOTS=/workspace,/data/prompts
# codex 联网搜索：live | cached | disabled；结果注入量 low | medium | high
CODEX_WEB_SEARCH=live
CODEX_WEB_SEARCH_CONTEXT=low
# 远程插件对 QQ 客服场景无用，默认关闭并清理 figma/gmail；其余已缓存插件仍会加载，全部清理设 CODEX_PLUGIN_PRUNE=all。
# off | on：off 写入 [features] plugins = false 与 remote_plugin = false（关闭插件市场同步/远程安装，内置技能保留）；on 省略该段，保持 codex 默认。
CODEX_REMOTE_PLUGINS=off
# 每次启动按逗号名单清缓存；all 清空精选远程市场目录，显式空字符串不清缓存（安装暂存目录始终清理）。
# 名单只允许 [A-Za-z0-9._-]，拒绝 . 和 ..；非法项告警跳过。
CODEX_PLUGIN_PRUNE=figma,gmail
# 单一 codex 线程安全阀：rollout 文件超过 N MB 或线程超过 N 天则新建线程
CODEX_ROLLOUT_MAX_MB=50
CODEX_THREAD_MAX_DAYS=90
# codex 浏览器 MCP：playwright（容器内 headless Chromium）| none
CODEX_BROWSER=playwright

# 执行 agent 后端：codex（容器内 codex 固定线程，默认）| pi（进程内 pi-durable 长期会话）
AGENT_BACKEND=codex
# 按会话覆盖后端（逗号分隔 scope=后端），例如 group:200000001=pi,private:10000001=codex
# owner 线程按首个 owner 账号的 private:<QQ号> 选择；切换在会话空闲且旧后端没有后台工作（pi 子 agent）后生效
AGENT_BACKEND_OVERRIDES=
# pi 容器内技能目录；留空使用 ${DATA_DIR}/skills，设为 off 禁用 pi 技能提示
PI_SKILLS_DIR=
# pi 外部 MCP：管理员维护的 UTF-8 JSON 配置绝对路径；留空禁用，详见 docs/PI-MCP.md
PI_MCP_CONFIG=
# 可选 Compose 服务：填 gmail 启用 Gmail sidecar，留空则不启动
COMPOSE_PROFILES=
# Gmail sidecar 的静态 Bearer：至少 32 字符的随机串，详见 docs/GMAIL-SIDECAR.md
GMAIL_SIDECAR_TOKEN=
# 填 Bearer <同一个串>，供 PI-MCP secretHeaders 引用
GMAIL_SIDECAR_AUTH_HEADER=
# OAuth 回调必须与公开 CIMD 文档逐字一致，不含 query/hash
PI_MCP_OAUTH_REDIRECT_URL=http://127.0.0.1:8787/mcp/oauth/callback
# pi-durable 1.3.0 压缩默认值；BACKGROUND=0 关闭后台压缩，阈值压缩仍开启
PI_COMPACTION_RESERVE_TOKENS=16384
PI_COMPACTION_BACKGROUND_TOKENS=32768

# 意图模型（用于聊天记录日/周摘要；pi 执行后端也使用它）：DeepSeek（OpenAI 兼容接口 https://api.deepseek.com，内置 pi-ai deepseek provider）
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL_ID=deepseek-flash
# DeepSeek API key（也可写作 DEEPSEEK_APIKEY，启动时自动映射为 DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY=
# deepseek-flash 支持 off/low/high/max；其他档位自动就近调整（如 medium → high）
AGENT_THINKING_LEVEL=low
# 同时处理的会话数：同一会话（群/私聊）内严格按消息顺序逐条处理，不同会话并行，总数不超过此值
AGENT_CONCURRENCY=2
# 其他可选 provider：
# AGENT_MODEL_PROVIDER=openai-codex   # 复用 /data/codex/auth.json 的 ChatGPT OAuth，无需 API key
# AGENT_MODEL_ID=gpt-6-luna
# AGENT_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# AGENT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# codex 与 pi 共用的宿主机技能目录，读写挂载，owner 发送的本轮消息与面板可写；留空使用 ./data/skills
# Windows 示例：C:/Users/<me>/.config/magpie/library/skills
SKILLS_DIR=
DATA_DIR=/data
WORKSPACE_DIR=/workspace
LOG_LEVEL=info

# 观测面板（宿主机仅发布到 http://localhost:8787）
OBS_RETENTION_DAYS=30
# 留空无口令；设置后首次访问 /?token=口令，随后使用 HttpOnly cookie
OBS_TOKEN=
# 可选 owner 私聊告警，所有告警共用每 30 分钟最多一次的限频
ALERT_OWNER=false
# deepseek-flash 每百万输入/输出 token 的单价；两项必须使用相同币种；0 表示尚未配置
DEEPSEEK_PRICE_IN_PER_M=0
DEEPSEEK_PRICE_OUT_PER_M=0

# 管理审计事件按年龄保留，不受单个 trace 键的数量和字节预算限制
OBS_ADMIN_RETENTION_DAYS=365
# pi 退休会话保留目标；当前 harness 无删除会话 API，详见 docs/DEPLOY.md
PI_ARCHIVE_RETENTION_DAYS=90
