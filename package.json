{
  "name": "cs-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:workers": "npm --prefix workers ci",
    "dev": "npm --prefix workers run dev",
    "build": "npm --prefix workers run build",
    "typecheck": "npm --prefix workers run typecheck",
    "test": "npm --prefix workers test --",
    "test:node": "npm --prefix workers run test:node",
    "test:all": "npm run test && npm run test:node",
    "check": "npm run typecheck && npm test -- --maxWorkers=1 && npm run test:node && npm run build",
    "deploy": "npm --prefix workers run deploy"
  }
}
